{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/chat": {
      "post": {
        "summary": "Send AI response and ask ChatGPT to infer user question",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "description": "Basic root endpoint to verify the server is running.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/history/{user_id}": {
      "get": {
        "summary": "Get chat history for a user",
        "operationId": "get_chat_history_history__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
        "/recommend": {
        "post": {
            "summary": "Generate product recommendations based on user message",
            "operationId": "recommend_post",
            "requestBody": {
            "content": {
                "application/json": {
                "schema": {
                    "$ref": "#/components/schemas/ProductQuery"
                }
                }
            },
            "required": true
            },
            "responses": {
            "200": {
                "description": "Successful Response",
                "content": {
                "application/json": {
                    "schema": {
                    "type": "object",
                    "properties": {
                        "user_id": { "type": "string" },
                        "message": { "type": "string" },
                        "keywords": {
                        "type": "array",
                        "items": { "type": "string" }
                        },
                        "recommendations": {
                        "type": "array",
                        "items": { "type": "string" }
                        }
                    }
                    }
                }
                }
            },
            "500": {
                "description": "Internal Server Error",
                "content": {
                "application/json": {
                    "schema": {
                    "type": "object",
                    "properties": {
                        "detail": { "type": "string" }
                    }
                    }
                }
                }
            }
            }
        }
    }
  },
  "components": {
    "schemas": {
      "ChatMessage": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "title": "Messages"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "messages",
          "timestamp"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "chat_history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat History",
            "default": [
              {
                "user_id": "{{user_id}}",
                "message": "{{input}}",
                "chat_history": [
                  {
                    "messages": [
                      {
                        "role": "user",
                        "content": "{{input}}",
                        "timestamp": "{{now_iso}}"
                      }
                    ],
                    "timestamp": "{{now_iso}}"
                  }
                ]
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "ChatRequest"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ProductQuery": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "example": "#商品検索 夏におすすめのアイテムは？"
          },
          "session_id": {
            "type": "string",
            "title": "Session ID",
            "example": "interquest_24"
          }
        },
        "required": ["query", "session_id"],
        "title": "ProductQuery"
      }
    }
  },
  "servers": [
    {
      "url": "https://a5a4-60-109-98-168.ngrok-free.app",
      "description": "ngrok tunnel to local FastAPI"
    }
  ]
}